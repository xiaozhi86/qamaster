  "citation_resolution": {
    "_doc": "反向引用完整性（v0.7.0·闭环 D1 悬空引用 + 台账Q悬空）。校验用例'关联规则'列引用的 R/RK/TP/API/SC/台账Q 是否在对应 section 清单内真实存在。仅校验 case->section 方向（section->case 由 risk/testpoint_coverage 已覆盖）。exit=1 硬门。external_citation_marker 为行级豁免标记（跨需求合法引用）。",
    "citation_pattern": "(R|RK|TP|API|SC)(\\d+)",
    "ledger_q_pattern": "台账Q(\\d+)",
    "section_id_definitions": [
      {"prefix": "R", "section": "规则建模", "kind": "prose"},
      {"prefix": "RK", "section": "风险清单|风险分析|风险列表", "kind": "table", "id_col": 0},
      {"prefix": "TP", "section": "测试点清单|测试点列表|测试点建模", "kind": "table", "id_col": 0},
      {"prefix": "API", "section": "变更影响清单|接口契约模型|变更接口清单", "kind": "table", "id_col": 0},
      {"prefix": "SC", "section": "场景清单|场景列表", "kind": "table", "id_col": 0},
      {"prefix": "A", "section": "假设清单|假设登记|待确认问题与假设清单", "kind": "table", "id_col": 0}
    ],
    "external_citation_marker": "（外部引用）|（跨需求）|\\(外部引用\\)|\\(跨需求\\)"
  },
  "section_contiguity": {
    "_doc": "section ID 编号连续性（v0.7.0·闭环 D2 跳号）。校验 R/RK/TP/API/SC 编号无跳号。check_ids 仅管用例 ID，本项管 section ID。R 按类目自由编号故 warn；RK/TP/API/SC 硬。取值 full=硬 exit=1 / warn=软提示 / off=关闭。domain_config 可覆盖。",
    "R": "warn",
    "RK": "full",
    "TP": "full",
    "API": "full",
    "SC": "full"
  },
